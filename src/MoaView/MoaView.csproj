<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>MoaView.Program</StartupObject>
    <AssemblyName>MoaView</AssemblyName>
    <RootNamespace>MoaView</RootNamespace>
    <Version>0.1.2</Version>
    <Product>MoaView</Product>
    <Description>Windows file preview</Description>
    <ApplicationIcon>Assets\Brand\MoaView.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <Resource Include="Assets\Brand\MoaView.ico" />
    <Content Include="Assets\Rive\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
