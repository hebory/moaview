<Window x:Class="MoaView.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MoaView.Models"
        Title="{Binding WindowTitle}"
        Width="960"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#181A1F"
        Foreground="#F3F4F6"
        AllowDrop="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    <Window.Resources>
        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C313C" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#3E4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A4252" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#525D73" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4B5568" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E222A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2A2F3A" />
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FitModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsImageVisible}" Value="True" />
                        <Condition Binding="{Binding IsFitToWindow}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#232832" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#374151" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2C313C" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#3E4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="9,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,8,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9CA3AF"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#3A4252" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#525D73" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#232832"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E222A" />
                                <Setter Property="BorderBrush" Value="#2A2F3A" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversionNoticeBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#251F24" />
            <Setter Property="BorderBrush" Value="#6B3A45" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="#172924" />
                    <Setter Property="BorderBrush" Value="#235347" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4C2630" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="#1E4D3B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Foreground" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control"
                    Key="O"
                    Command="{Binding OpenFileCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Modifiers="Control+Shift"
                    Key="S"
                    Command="{Binding ConvertImageCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 헤더 툴바 -->
        <Border Grid.Row="0"
                Background="#21252B"
                BorderBrush="#2F3540"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="모아뷰"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button x:Name="OpenFileButton"
                            Content="파일 선택..."
                            Command="{Binding OpenFileCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Padding="12,5"
                            Background="#3B82F6"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="미리 볼 파일을 선택합니다 (Ctrl+O)" />
                </StackPanel>

                <TextBlock x:Name="SupportedFormatsBanner"
                           DockPanel.Dock="Right"
                           Text="{Binding SupportedFormatsSummary}"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 이미지 보기 조작 툴바 -->
        <Border x:Name="ViewerToolbar"
                Grid.Row="1"
                Background="#1B1E24"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1"
                Padding="14,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 폴더 내 이전·다음 이동 -->
                <Button x:Name="PreviousImageButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="◀ 이전"
                        Command="{Binding PreviousImageCommand}"
                        Margin="0,2,6,2"
                        ToolTip="같은 폴더의 이전 이미지 (← / PageUp)" />
                <TextBlock x:Name="FolderPositionText"
                           Text="{Binding FolderPositionDisplay}"
                           MinWidth="46"
                           TextAlignment="Center"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,2,6,2" />
                <Button x:Name="NextImageButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="다음 ▶"
                        Command="{Binding NextImageCommand}"
                        Margin="0,2,12,2"
                        ToolTip="같은 폴더의 다음 이미지 (→ / PageDown)" />

                <Rectangle Width="1"
                           Height="18"
                           Fill="#2F3540"
                           VerticalAlignment="Center"
                           Margin="0,2,12,2" />

                <!-- 확대·축소 및 화면 맞춤 -->
                <Button x:Name="ZoomOutButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="축소 -"
                        Command="{Binding ZoomOutCommand}"
                        Margin="0,2,6,2"
                        ToolTip="축소 (- / Ctrl+-)" />
                <TextBlock x:Name="ZoomStatusText"
                           Text="{Binding ZoomDisplay}"
                           MinWidth="84"
                           TextAlignment="Center"
                           Foreground="#E5E7EB"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,2,6,2" />
                <Button x:Name="ZoomInButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="확대 +"
                        Command="{Binding ZoomInCommand}"
                        Margin="0,2,6,2"
                        ToolTip="확대 (+ / Ctrl++)" />
                <Button x:Name="ActualSizeButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="100%"
                        Command="{Binding ActualSizeCommand}"
                        Margin="0,2,6,2"
                        ToolTip="원본 픽셀 크기 100% (0 / Ctrl+0)" />
                <Button x:Name="FitToWindowButton"
                        Style="{StaticResource FitModeButtonStyle}"
                        Content="화면 맞춤"
                        Command="{Binding ToggleFitToWindowCommand}"
                        Margin="0,2,12,2"
                        ToolTip="창 크기에 맞춤 전환 (F / *)" />

                <Rectangle Width="1"
                           Height="18"
                           Fill="#2F3540"
                           VerticalAlignment="Center"
                           Margin="0,2,12,2" />

                <!-- 좌·우 90도 회전 -->
                <Button x:Name="RotateLeftButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="↺ 좌회전"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        Margin="0,2,6,2"
                        ToolTip="반시계 방향 90° 회전 (L / Ctrl+Shift+R)" />
                <Button x:Name="RotateRightButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="↻ 우회전"
                        Command="{Binding RotateClockwiseCommand}"
                        Margin="0,2,8,2"
                        ToolTip="시계 방향 90° 회전 (R / Ctrl+R)" />
                <TextBlock x:Name="RotationStatusText"
                           Text="{Binding RotationDisplay}"
                           MinWidth="32"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,2,12,2" />

                <Rectangle Width="1"
                           Height="18"
                           Fill="#2F3540"
                           VerticalAlignment="Center"
                           Margin="0,2,12,2" />

                <!-- 이미지 형식 변환 (JPEG, PNG, BMP) -->
                <TextBlock Text="변환"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,2,6,2" />
                <ComboBox x:Name="ConvertFormatComboBox"
                          Style="{StaticResource DarkToolbarComboBoxStyle}"
                          ItemsSource="{Binding AvailableConversionFormats}"
                          SelectedItem="{Binding SelectedConversionFormatOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding CanExecuteConversion}"
                          Focusable="False"
                          MinWidth="104"
                          Margin="0,2,6,2"
                          ToolTip="변환 저장할 목표 이미지 형식 (JPEG, PNG, BMP)" />
                <Button x:Name="ConvertImageButton"
                        Style="{StaticResource ViewerToolbarButtonStyle}"
                        Content="변환 저장..."
                        Command="{Binding ConvertImageCommand}"
                        CommandParameter="{Binding ElementName=RootWindow}"
                        Margin="0,2,0,2"
                        ToolTip="JPEG, PNG, BMP 형식으로 새 파일에 변환 저장합니다 (Ctrl+Shift+S)" />
            </WrapPanel>
        </Border>

        <!-- 이미지 변환 결과·오류·사전 안내 배너 -->
        <Border x:Name="ConversionNoticeBanner"
                Grid.Row="2"
                Style="{StaticResource ConversionNoticeBannerStyle}"
                Visibility="{Binding ConversionNoticeVisibility}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ConversionNoticeBadgeBorderStyle}"
                        CornerRadius="4"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="ConversionNoticeBadgeText"
                               Style="{StaticResource ConversionNoticeBadgeTextStyle}"
                               Text="{Binding ConversionNoticeBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                </Border>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConversionNoticeTitleText"
                               Text="{Binding ConversionNoticeTitle}"
                               Foreground="#F9FAFB"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ConversionNoticeMessageText"
                               Text="{Binding ConversionNoticeMessage}"
                               Foreground="#E5E7EB"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="OpenConvertedFileButton"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            Content="결과 파일 열기"
                            Visibility="{Binding OpenConvertedFileVisibility}"
                            Command="{Binding OpenConvertedFileCommand}"
                            Margin="0,0,6,0"
                            ToolTip="방금 변환된 결과 이미지 파일을 미리보기로 엽니다" />
                    <Button x:Name="DismissConversionNoticeButton"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            Content="닫기"
                            Command="{Binding DismissConversionNoticeCommand}"
                            ToolTip="변환 안내 배너 닫기" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 미리보기 영역 -->
        <Grid x:Name="ContentHostGrid"
              Grid.Row="3"
              Background="#14161A"
              SizeChanged="OnContentHostSizeChanged">
            <!-- 1) 초기 대기 안내 -->
            <Border x:Name="EmptyStatePanel"
                    Visibility="{Binding EmptyStateVisibility}"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1F232A"
                    BorderBrush="#2E3440"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#D1D5DB"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="EmptyStateFormatsText"
                               Text="{Binding SupportedFormatsDetail}"
                               FontSize="12.5"
                               Foreground="#93C5FD"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 2) 지원 이미지 미리보기 -->
            <Border x:Name="ImageViewport"
                    Visibility="{Binding ImageVisibility}"
                    Padding="16">
                <ScrollViewer x:Name="ImageScrollViewer"
                              BorderThickness="0"
                              Padding="0"
                              Focusable="False"
                              HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
                              SizeChanged="OnImageScrollViewerSizeChanged"
                              PreviewMouseWheel="OnImageViewportPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnImageViewportMouseLeftButtonDown"
                              PreviewMouseMove="OnImageViewportMouseMove"
                              PreviewMouseLeftButtonUp="OnImageViewportMouseLeftButtonUp"
                              LostMouseCapture="OnImageViewportLostMouseCapture">
                    <Image x:Name="PreviewImage"
                           Source="{Binding PreviewBitmap}"
                           Width="{Binding ImageDisplayWidth}"
                           Height="{Binding ImageDisplayHeight}"
                           Stretch="{Binding ImageStretch}"
                           StretchDirection="Both"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>
            </Border>

            <!-- 3) 미지원 형식 및 처리 불가 안내 -->
            <Border x:Name="NoticePanel"
                    Visibility="{Binding NoticeVisibility}"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#231F24"
                    BorderBrush="#6B3A45"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <Border Background="#4C2630"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="NoticeBadgeText"
                                   Text="{Binding NoticeBadgeText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FCA5A5" />
                    </Border>
                    <TextBlock x:Name="NoticeTitleText"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="NoticeMessageText"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#E5E7EB"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="NoticeSupportedFormatsText"
                               Text="{Binding SupportedFormatsDetail}"
                               FontSize="12.5"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="4"
                Background="#21252B"
                BorderBrush="#2F3540"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentFilePathText"
                           Grid.Column="0"
                           Text="{Binding CurrentFilePathDisplay}"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <TextBlock x:Name="ImageMetadataText"
                           Grid.Column="1"
                           Text="{Binding MetadataSummary}"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
