<Window x:Class="MoaView.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MoaView.Models"
        xmlns:controls="clr-namespace:MoaView.Controls"
        Title="{Binding WindowTitle}"
        Icon="Assets/Brand/MoaView.ico"
        Width="960"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#181A1F"
        Foreground="#F3F4F6"
        AllowDrop="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    <Window.Resources>
        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C313C" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#3E4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A4252" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#525D73" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4B5568" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A5B4FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E222A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2A2F3A" />
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#242B37" />
            <Setter Property="BorderBrush" Value="#495669" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="TextElement.Foreground" Value="#F3F4F6" />
        </Style>
        <Style x:Key="FlyoutHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FlyoutHelpStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B3BECD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="FitModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsImageVisible}" Value="True" />
                        <Condition Binding="{Binding IsFitToWindow}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#232832" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#374151" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2C313C" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#3E4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="9,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,8,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9CA3AF"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#3A4252" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#525D73" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#232832"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E222A" />
                                <Setter Property="BorderBrush" Value="#2A2F3A" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversionNoticeBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#251F24" />
            <Setter Property="BorderBrush" Value="#6B3A45" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="#172924" />
                    <Setter Property="BorderBrush" Value="#235347" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4C2630" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="#1E4D3B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Foreground" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control"
                    Key="O"
                    Command="{Binding OpenFileCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Modifiers="Control+Shift"
                    Key="S"
                    Command="{Binding ConvertImageCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#20252F" BorderBrush="#343D4C" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙  설정"
                        Style="{StaticResource ViewerToolbarButtonStyle}" Padding="12,6"
                        AutomationProperties.Name="설정" Click="OnSettingsClick"
                        ToolTip="탐색기 연동, 마크다운 테마, 사용 안내" />
                <TextBlock x:Name="ExplorerPreviewHint" DockPanel.Dock="Right" Text="Esc 또는 Space로 닫기"
                           Foreground="#AAB4C3" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/MoaView.png" Width="28" Height="28" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="모아뷰" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="OpenFileButton" Content="파일 열기" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Visibility="{Binding OpenedFileVisibility}"
                            Command="{Binding OpenFileCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                            Padding="12,6" ToolTip="미리 볼 파일 열기 (Ctrl+O)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutCardStyle}" Width="352" PreviewKeyDown="OnSettingsPreviewKeyDown"
                    KeyboardNavigation.TabNavigation="Cycle">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="SettingsCloseButton" DockPanel.Dock="Right" Content="닫기" Style="{StaticResource ViewerToolbarButtonStyle}"
                                Click="OnCloseSettingsClick" AutomationProperties.Name="설정 닫기" />
                        <TextBlock Text="설정" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="350">
                        <StackPanel Margin="0,0,6,0">
                            <StackPanel x:Name="ExplorerSettingsGroup" Margin="0,0,0,16">
                                <TextBlock Text="탐색기" Style="{StaticResource FlyoutHeadingStyle}" />
                                <CheckBox x:Name="ExplorerIntegrationToggle" Content="Space 키로 미리보기" Foreground="#F3F4F6"
                                          Click="OnExplorerIntegrationToggleClick" />
                                <TextBlock x:Name="ExplorerIntegrationMessage" Style="{StaticResource FlyoutHelpStyle}"
                                           Text="모아뷰가 켜져 있을 때 탐색기에서 파일 하나를 선택하고 Space를 누르세요." />
                            </StackPanel>
                            <TextBlock Text="마크다운" Style="{StaticResource FlyoutHeadingStyle}" />
                            <DockPanel Margin="0,0,0,2" LastChildFill="False">
                                <TextBlock Text="테마" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="MarkdownThemePicker" Width="120" Style="{StaticResource DarkToolbarComboBoxStyle}"
                                          ItemsSource="{Binding MarkdownThemes}" SelectedItem="{Binding SelectedMarkdownTheme, Mode=TwoWay}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="마크다운 미리보기 테마" />
                            </DockPanel>
                            <TextBlock Text="선택한 테마는 다음 실행에도 유지됩니다." Style="{StaticResource FlyoutHelpStyle}" />
                            <TextBlock Text="{Binding MarkdownSettingsMessage}" Visibility="{Binding MarkdownSettingsMessageVisibility}"
                                       Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Expander Header="지원 파일과 단축키" Foreground="#F3F4F6" Margin="0,16,0,0">
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock x:Name="SupportedFormatsBanner" Text="{Binding SupportedFormatsDetail}"
                                               Style="{StaticResource FlyoutHelpStyle}" />
                                    <TextBlock Text="Ctrl+O 파일 열기 · Ctrl+Shift+S 이미지 변환 · F 화면 맞춤"
                                               Style="{StaticResource FlyoutHelpStyle}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Border x:Name="ViewerToolbar" Grid.Row="1" Visibility="{Binding ViewerToolbarVisibility}"
                Background="#1B2028" BorderBrush="#303844" BorderThickness="0,0,0,1" Padding="16,6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding NavigationVisibility}">
                    <Button x:Name="PreviousImageButton" Content="‹ 이전" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding PreviousImageCommand}" ToolTip="이전 이미지 (← / PageUp)" />
                    <TextBlock x:Name="FolderPositionText" Text="{Binding FolderPositionDisplay}" MinWidth="42"
                               TextAlignment="Center" Foreground="#AAB4C3" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                    <Button x:Name="NextImageButton" Content="다음 ›" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding NextImageCommand}" ToolTip="다음 이미지 (→ / PageDown)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ImageVisibility}">
                    <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding ZoomOutCommand}" AutomationProperties.Name="축소" ToolTip="축소 (- / Ctrl+-)" />
                    <TextBlock x:Name="ZoomStatusText" Text="{Binding EffectiveZoomPercent, StringFormat={}{0}%}" ToolTip="{Binding ZoomDisplay}"
                               MinWidth="48" TextAlignment="Center"
                               Foreground="#E5E7EB" FontSize="12" VerticalAlignment="Center" Margin="6,0" />
                    <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding ZoomInCommand}" AutomationProperties.Name="확대" ToolTip="확대 (+ / Ctrl++)" />
                    <Button x:Name="FitToWindowButton" Content="화면 맞춤" Style="{StaticResource FitModeButtonStyle}"
                            Command="{Binding ToggleFitToWindowCommand}" Margin="8,0,0,0" ToolTip="창 크기에 맞춤 (F)" />
                    <Button x:Name="ImageOptionsButton" Content="더보기 ▾" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Margin="8,0,0,0" Click="OnImageOptionsClick" ToolTip="원본 크기, 회전, 변환 저장" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Popup x:Name="ImageOptionsPopup" PlacementTarget="{Binding ElementName=ImageOptionsButton}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutCardStyle}" Width="300" PreviewKeyDown="OnImageOptionsPreviewKeyDown"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="ImageOptionsCloseButton" DockPanel.Dock="Right" Content="닫기" Style="{StaticResource ViewerToolbarButtonStyle}"
                                Click="OnCloseImageOptionsClick" AutomationProperties.Name="이미지 도구 닫기" />
                        <TextBlock Text="이미지 도구" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button x:Name="ActualSizeButton" Content="원본 크기 (100%)" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding ActualSizeCommand}" HorizontalAlignment="Left" ToolTip="원본 픽셀 크기 (0)" />
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button x:Name="RotateLeftButton" Content="왼쪽으로 회전" Style="{StaticResource ViewerToolbarButtonStyle}"
                                Command="{Binding RotateCounterClockwiseCommand}" Margin="0,0,6,0" ToolTip="왼쪽으로 90° (L)" />
                        <Button x:Name="RotateRightButton" Content="오른쪽으로 회전" Style="{StaticResource ViewerToolbarButtonStyle}"
                                Command="{Binding RotateClockwiseCommand}" Margin="0,0,6,0" ToolTip="오른쪽으로 90° (R)" />
                        <TextBlock x:Name="RotationStatusText" Text="{Binding RotationDisplay}" Foreground="#AAB4C3" VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding ConversionToolsVisibility}" Margin="0,16,0,0">
                        <TextBlock Text="다른 형식으로 저장" Style="{StaticResource FlyoutHeadingStyle}" />
                        <WrapPanel>
                            <ComboBox x:Name="ConvertFormatComboBox" Style="{StaticResource DarkToolbarComboBoxStyle}"
                                      ItemsSource="{Binding AvailableConversionFormats}" SelectedItem="{Binding SelectedConversionFormatOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanExecuteConversion}"
                                      MinWidth="114" Margin="0,0,8,0" AutomationProperties.Name="저장할 이미지 형식" />
                            <Button x:Name="ConvertImageButton" Content="변환 저장…" Style="{StaticResource ViewerToolbarButtonStyle}"
                                    Command="{Binding ConvertImageCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                                    Click="OnCloseImageOptionsClick" ToolTip="변환 저장 (Ctrl+Shift+S)" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <!-- 이미지 변환 결과·오류·사전 안내 배너 -->
        <Border x:Name="ConversionNoticeBanner"
                Grid.Row="2"
                Style="{StaticResource ConversionNoticeBannerStyle}"
                Visibility="{Binding ConversionNoticeVisibility}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ConversionNoticeBadgeBorderStyle}"
                        CornerRadius="4"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="ConversionNoticeBadgeText"
                               Style="{StaticResource ConversionNoticeBadgeTextStyle}"
                               Text="{Binding ConversionNoticeBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                </Border>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConversionNoticeTitleText"
                               Text="{Binding ConversionNoticeTitle}"
                               Foreground="#F9FAFB"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ConversionNoticeMessageText"
                               Text="{Binding ConversionNoticeMessage}"
                               Foreground="#E5E7EB"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="OpenConvertedFileButton"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            Content="결과 파일 열기"
                            Visibility="{Binding OpenConvertedFileVisibility}"
                            Command="{Binding OpenConvertedFileCommand}"
                            Margin="0,0,6,0"
                            ToolTip="방금 변환된 결과 이미지 파일을 미리보기로 엽니다" />
                    <Button x:Name="DismissConversionNoticeButton"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            Content="닫기"
                            Command="{Binding DismissConversionNoticeCommand}"
                            ToolTip="변환 안내 배너 닫기" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 미리보기 영역 -->
        <Grid x:Name="ContentHostGrid"
              Grid.Row="3"
              Background="#14161A"
              SizeChanged="OnContentHostSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ArchiveColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="ArchivePanel" Grid.Column="0" Visibility="{Binding ArchiveVisibility}"
                       Background="#20242C" Margin="0,0,1,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ArchiveSummary}" Margin="12" FontWeight="SemiBold" />
                <ListBox x:Name="ArchiveEntryList" ItemsSource="{Binding ArchiveEntries}"
                         SelectedItem="{Binding SelectedArchiveEntry, Mode=TwoWay}" Background="#20242C"
                         Foreground="#E5E7EB" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6" MaxWidth="200">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel x:Name="PurPanel" Grid.Column="0" Visibility="{Binding PurVisibility}"
                       Background="#20242C" Margin="0,0,1,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PurSummary}" Margin="12" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ContentDescription}" Margin="12,0,12,12"
                           Foreground="#93C5FD" TextWrapping="Wrap" FontSize="12" />
                <ListBox x:Name="PurImageList" ItemsSource="{Binding PurImages}"
                         SelectedItem="{Binding SelectedPurImage, Mode=TwoWay}" Background="#20242C"
                         Foreground="#E5E7EB" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6" MaxWidth="200">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Description}" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border x:Name="ArchivePlaceholder" Grid.Column="1" Visibility="{Binding ArchivePlaceholderVisibility}" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <DockPanel x:Name="TextViewport" Grid.Column="1" Visibility="{Binding TextVisibility}" Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ContentDescription}" Foreground="#93C5FD" Margin="0,0,0,10" TextWrapping="Wrap" />
                <WrapPanel x:Name="MarkdownToolbar" DockPanel.Dock="Top" Visibility="{Binding MarkdownToolbarVisibility}" Margin="0,0,0,10">
                    <CheckBox x:Name="MarkdownSourceToggle" Content="원문 보기" IsChecked="{Binding ShowMarkdownSource}"
                              VerticalAlignment="Center" Foreground="#E5E7EB" />
                </WrapPanel>
                <ComboBox x:Name="DocumentSectionPicker" DockPanel.Dock="Top" Margin="0,0,0,12"
                          Visibility="{Binding DocumentSectionVisibility}"
                          ItemsSource="{Binding DocumentSections}" SelectedItem="{Binding SelectedDocumentSection, Mode=TwoWay}"
                          DisplayMemberPath="Title" Style="{StaticResource DarkToolbarComboBoxStyle}" />
                <Grid>
                <TextBox x:Name="PreviewText" Text="{Binding TextContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         Visibility="{Binding TextSourceVisibility}"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{Binding TextBackground}" Foreground="{Binding TextForeground}" BorderBrush="{Binding TextBorderBrush}" Padding="16"
                         FontFamily="Consolas, Malgun Gothic" FontSize="14" />
                <controls:MarkdownPreviewControl x:Name="MarkdownPreview" Markdown="{Binding MarkdownContent}" Theme="{Binding SelectedMarkdownTheme}"
                                                 Visibility="{Binding MarkdownRenderedVisibility}" />
                </Grid>
            </DockPanel>
            <Grid x:Name="RiveViewport" Grid.Column="1" Visibility="{Binding RiveVisibility}" />
            <Grid x:Name="SpecializedViewport" Grid.Column="1" Visibility="{Binding SpecializedVisibility}" />
            <!-- 1) 초기 대기 안내 -->
            <Border x:Name="EmptyStatePanel"
                    Grid.Column="1"
                    Visibility="{Binding EmptyStateVisibility}"
                    Width="440"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1C222D"
                    BorderBrush="#394456"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="26,24"
                    Margin="24">
                <StackPanel>
                    <Image Source="Assets/Brand/MoaView.png" Width="56" Height="56" Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="{Binding StatusTitle}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               TextAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#D1D5DB"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18" />
                    <Button x:Name="EmptyOpenFileButton" Content="파일 열기" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding OpenFileCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                            HorizontalAlignment="Center" Background="#435BE4" BorderBrush="#788BF6"
                            FontSize="14" FontWeight="SemiBold" Padding="22,8" />
                    <TextBlock Text="Ctrl+O로도 열 수 있어요" Foreground="#AAB4C3" FontSize="12"
                               TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 2) 지원 이미지 미리보기 -->
            <Border x:Name="ImageViewport"
                    Grid.Column="1"
                    Visibility="{Binding ImageVisibility}"
                    Padding="16">
                <ScrollViewer x:Name="ImageScrollViewer"
                              BorderThickness="0"
                              Padding="0"
                              Focusable="False"
                              HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
                              SizeChanged="OnImageScrollViewerSizeChanged"
                              PreviewMouseWheel="OnImageViewportPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnImageViewportMouseLeftButtonDown"
                              PreviewMouseMove="OnImageViewportMouseMove"
                              PreviewMouseLeftButtonUp="OnImageViewportMouseLeftButtonUp"
                              LostMouseCapture="OnImageViewportLostMouseCapture">
                    <Image x:Name="PreviewImage"
                           Source="{Binding PreviewBitmap}"
                           Width="{Binding ImageDisplayWidth}"
                           Height="{Binding ImageDisplayHeight}"
                           Stretch="{Binding ImageStretch}"
                           StretchDirection="Both"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>
            </Border>

            <!-- 3) 미지원 형식 및 처리 불가 안내 -->
            <Border x:Name="NoticePanel"
                    Grid.Column="1"
                    Visibility="{Binding NoticeVisibility}"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#231F24"
                    BorderBrush="#6B3A45"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <Border Background="#4C2630"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="NoticeBadgeText"
                                   Text="{Binding NoticeBadgeText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FCA5A5" />
                    </Border>
                    <TextBlock x:Name="NoticeTitleText"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="NoticeMessageText"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#E5E7EB"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="4"
                Visibility="{Binding OpenedFileVisibility}"
                Background="#21252B"
                BorderBrush="#2F3540"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentFilePathText"
                           Grid.Column="0"
                           Text="{Binding CurrentFileNameDisplay}" ToolTip="{Binding CurrentFilePathDisplay}"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <TextBlock x:Name="ImageMetadataText"
                           Grid.Column="1"
                           Text="{Binding MetadataSummary}"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           FontWeight="Medium"
                           MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataSummary}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
