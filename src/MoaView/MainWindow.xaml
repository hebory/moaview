<Window x:Class="MoaView.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="920"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#181A1F"
        Foreground="#F3F4F6"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control"
                    Key="O"
                    Command="{Binding OpenFileCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 툴바 -->
        <Border Grid.Row="0"
                Background="#21252B"
                BorderBrush="#2F3540"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="모아뷰"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button x:Name="OpenFileButton"
                            Content="파일 선택..."
                            Command="{Binding OpenFileCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Padding="12,5"
                            Background="#3B82F6"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="미리 볼 파일을 선택합니다 (Ctrl+O)" />
                </StackPanel>

                <TextBlock x:Name="SupportedFormatsBanner"
                           DockPanel.Dock="Right"
                           Text="{Binding SupportedFormatsSummary}"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 본문 미리보기 영역 -->
        <Grid Grid.Row="1" Background="#14161A">
            <!-- 1) 초기 대기 안내 -->
            <Border x:Name="EmptyStatePanel"
                    Visibility="{Binding EmptyStateVisibility}"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1F232A"
                    BorderBrush="#2E3440"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#D1D5DB"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="EmptyStateFormatsText"
                               Text="{Binding SupportedFormatsDetail}"
                               FontSize="12.5"
                               Foreground="#93C5FD"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 2) 지원 이미지 미리보기 -->
            <Border x:Name="ImageViewport"
                    Visibility="{Binding ImageVisibility}"
                    Padding="16">
                <Image x:Name="PreviewImage"
                       Source="{Binding PreviewBitmap}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- 3) 미지원 형식 및 처리 불가 안내 -->
            <Border x:Name="NoticePanel"
                    Visibility="{Binding NoticeVisibility}"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#231F24"
                    BorderBrush="#6B3A45"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <Border Background="#4C2630"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="NoticeBadgeText"
                                   Text="{Binding NoticeBadgeText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FCA5A5" />
                    </Border>
                    <TextBlock x:Name="NoticeTitleText"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="NoticeMessageText"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="#E5E7EB"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="NoticeSupportedFormatsText"
                               Text="{Binding SupportedFormatsDetail}"
                               FontSize="12.5"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="2"
                Background="#21252B"
                BorderBrush="#2F3540"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentFilePathText"
                           Grid.Column="0"
                           Text="{Binding CurrentFilePathDisplay}"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <TextBlock x:Name="ImageMetadataText"
                           Grid.Column="1"
                           Text="{Binding MetadataSummary}"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
