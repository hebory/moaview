<Window x:Class="MoaView.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MoaView.Models"
        xmlns:controls="clr-namespace:MoaView.Controls"
        Title="{Binding WindowTitle}"
        Icon="Assets/Brand/MoaView.ico"
        Width="960"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        AllowDrop="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    <Window.Resources>
        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppDisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
        </Style>

        <Style x:Key="ThemeTileStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppControlBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3,6">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Tile" Property="Padding" Value="2,5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AppPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewSourceStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMarkdown}" Value="True">
                    <Setter Property="Background" Value="{Binding TextBackground}" />
                    <Setter Property="Foreground" Value="{Binding TextForeground}" />
                    <Setter Property="BorderBrush" Value="{Binding TextBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewEntryStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Entry" Margin="4,1" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Entry" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Entry" Property="Background" Value="{DynamicResource AppControlBrush}" />
                                <Setter TargetName="Entry" Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Entry" Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style x:Key="FlyoutHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FlyoutHelpStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="FitModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconToolbarButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsImageVisible}" Value="True" />
                        <Condition Binding="{Binding IsFitToWindow}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="9,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,8,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource AppMutedBrush}"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource AppPanelBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversionNoticeBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppErrorSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppErrorBadgeBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Background" Value="{DynamicResource AppSuccessBadgeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionNoticeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppErrorTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConversionStatus}" Value="{x:Static models:ConversionStatusKind.Succeeded}">
                    <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control"
                    Key="O"
                    Command="{Binding OpenFileCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Modifiers="Control+Shift"
                    Key="S"
                    Command="{Binding ConvertImageCommand}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right"
                        Style="{StaticResource IconToolbarButtonStyle}"
                        AutomationProperties.Name="설정" Click="OnSettingsClick"
                        ToolTip="설정 · 앱 테마, 탐색기 연동, 사용 안내">
                    <controls:AppIcon Kind="Settings" />
                </Button>
                <TextBlock x:Name="ExplorerPreviewHint" DockPanel.Dock="Right" Text="Esc 또는 Space로 닫기"
                           Foreground="{DynamicResource AppMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/MoaView.png" Width="28" Height="28" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="모아뷰" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="OpenFileButton" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Visibility="{Binding OpenedFileVisibility}"
                            Command="{Binding OpenFileCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                            AutomationProperties.Name="파일 열기" ToolTip="미리 볼 파일 열기 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="Open" Margin="0,0,7,0" />
                            <TextBlock Text="파일 열기" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutCardStyle}" Width="392" PreviewKeyDown="OnSettingsPreviewKeyDown"
                    KeyboardNavigation.TabNavigation="Cycle">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="SettingsCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconToolbarButtonStyle}"
                                Click="OnCloseSettingsClick" AutomationProperties.Name="설정 닫기" ToolTip="설정 닫기 (Esc)">
                            <controls:AppIcon Kind="Close" />
                        </Button>
                        <TextBlock Text="설정" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="350">
                        <StackPanel Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Kind="Palette" Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="앱 테마" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListBox x:Name="AppThemePicker" ItemContainerStyle="{StaticResource ThemeTileStyle}"
                                     SelectedValuePath="Theme" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="앱 테마">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="34" Height="20" CornerRadius="5" Background="{Binding Swatch}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                                <Border Width="13" Height="5" CornerRadius="2" Background="{Binding Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="AppThemeSaveMessage" Foreground="{DynamicResource AppWarningBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                            <Separator Margin="0,12,0,10" Background="{DynamicResource AppBorderBrush}" />
                            <StackPanel x:Name="ExplorerSettingsGroup" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <controls:AppIcon Kind="Explorer" Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="탐색기" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox x:Name="ExplorerIntegrationToggle" Content="Space 키로 미리보기" Foreground="{DynamicResource AppTextBrush}"
                                          Click="OnExplorerIntegrationToggleClick" />
                                <TextBlock x:Name="ExplorerIntegrationMessage" Style="{StaticResource FlyoutHelpStyle}"
                                           Text="모아뷰가 켜져 있을 때 탐색기에서 파일 하나를 선택하고 Space를 누르세요." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:AppIcon Kind="Markdown" Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="마크다운" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <DockPanel Margin="0,0,0,2" LastChildFill="False">
                                <TextBlock Text="읽기 테마" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="MarkdownThemePicker" Width="120" Style="{StaticResource ToolbarComboBoxStyle}"
                                          ItemsSource="{Binding MarkdownThemes}" SelectedItem="{Binding SelectedMarkdownTheme, Mode=TwoWay}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="마크다운 미리보기 테마" />
                            </DockPanel>
                            <TextBlock Text="마크다운 문서의 색을 따로 고를 수 있어요." Style="{StaticResource FlyoutHelpStyle}" />
                            <TextBlock Text="{Binding MarkdownSettingsMessage}" Visibility="{Binding MarkdownSettingsMessageVisibility}"
                                       Foreground="{DynamicResource AppWarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Expander AutomationProperties.Name="지원 파일과 단축키" Foreground="{DynamicResource AppTextBrush}" Margin="0,16,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Kind="Help" Width="15" Height="15" Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="지원 파일과 단축키" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock x:Name="SupportedFormatsBanner" Text="{Binding SupportedFormatsDetail}"
                                               Style="{StaticResource FlyoutHelpStyle}" />
                                    <TextBlock Text="Ctrl+O 파일 열기 · Ctrl+Shift+S 이미지 변환 · F 화면 맞춤"
                                               Style="{StaticResource FlyoutHelpStyle}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Border x:Name="ViewerToolbar" Grid.Row="1" Visibility="{Binding ViewerToolbarVisibility}"
                Background="{DynamicResource AppWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding NavigationVisibility}">
                    <Button x:Name="PreviousImageButton" Style="{StaticResource IconToolbarButtonStyle}"
                            Command="{Binding PreviousImageCommand}" AutomationProperties.Name="이전 이미지"
                            ToolTip="이전 이미지 (← / PageUp)">
                        <controls:AppIcon Kind="Previous" />
                    </Button>
                    <TextBlock x:Name="FolderPositionText" Text="{Binding FolderPositionDisplay}" MinWidth="42"
                               TextAlignment="Center" Foreground="{DynamicResource AppMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                    <Button x:Name="NextImageButton" Style="{StaticResource IconToolbarButtonStyle}"
                            Command="{Binding NextImageCommand}" AutomationProperties.Name="다음 이미지"
                            ToolTip="다음 이미지 (→ / PageDown)">
                        <controls:AppIcon Kind="Next" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ImageVisibility}">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconToolbarButtonStyle}"
                            Command="{Binding ZoomOutCommand}" AutomationProperties.Name="축소" ToolTip="축소 (- / Ctrl+-)">
                        <controls:AppIcon Kind="ZoomOut" />
                    </Button>
                    <TextBlock x:Name="ZoomStatusText" Text="{Binding EffectiveZoomPercent, StringFormat={}{0}%}" ToolTip="{Binding ZoomDisplay}"
                               MinWidth="48" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="6,0" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconToolbarButtonStyle}"
                            Command="{Binding ZoomInCommand}" AutomationProperties.Name="확대" ToolTip="확대 (+ / Ctrl++)">
                        <controls:AppIcon Kind="ZoomIn" />
                    </Button>
                    <Button x:Name="FitToWindowButton" Style="{StaticResource FitModeButtonStyle}"
                            Command="{Binding ToggleFitToWindowCommand}" Margin="8,0,0,0" AutomationProperties.Name="화면 맞춤"
                            ToolTip="화면 맞춤 (F)">
                        <controls:AppIcon Kind="Fit" />
                    </Button>
                    <Button x:Name="ImageOptionsButton" Style="{StaticResource IconToolbarButtonStyle}"
                            Margin="6,0,0,0" Click="OnImageOptionsClick" AutomationProperties.Name="이미지 도구"
                            ToolTip="이미지 도구 · 원본 크기, 회전, 변환 저장">
                        <controls:AppIcon Kind="More" />
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Popup x:Name="ImageOptionsPopup" PlacementTarget="{Binding ElementName=ImageOptionsButton}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource FlyoutCardStyle}" Width="300" PreviewKeyDown="OnImageOptionsPreviewKeyDown"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="ImageOptionsCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconToolbarButtonStyle}"
                                Click="OnCloseImageOptionsClick" AutomationProperties.Name="이미지 도구 닫기" ToolTip="이미지 도구 닫기 (Esc)">
                            <controls:AppIcon Kind="Close" />
                        </Button>
                        <TextBlock Text="이미지 도구" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button x:Name="ActualSizeButton" Style="{StaticResource ViewerToolbarButtonStyle}"
                            Command="{Binding ActualSizeCommand}" HorizontalAlignment="Left" AutomationProperties.Name="원본 크기"
                            ToolTip="원본 픽셀 크기 (0)">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="ActualSize" Margin="0,0,7,0" />
                            <TextBlock Text="원본 크기 (100%)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button x:Name="RotateLeftButton" Style="{StaticResource IconToolbarButtonStyle}"
                                Command="{Binding RotateCounterClockwiseCommand}" Margin="0,0,6,0" AutomationProperties.Name="왼쪽으로 회전"
                                ToolTip="왼쪽으로 회전 · 90° (L)">
                            <controls:AppIcon Kind="RotateLeft" />
                        </Button>
                        <Button x:Name="RotateRightButton" Style="{StaticResource IconToolbarButtonStyle}"
                                Command="{Binding RotateClockwiseCommand}" Margin="0,0,6,0" AutomationProperties.Name="오른쪽으로 회전"
                                ToolTip="오른쪽으로 회전 · 90° (R)">
                            <controls:AppIcon Kind="RotateRight" />
                        </Button>
                        <TextBlock x:Name="RotationStatusText" Text="{Binding RotationDisplay}" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding ConversionToolsVisibility}" Margin="0,16,0,0">
                        <TextBlock Text="다른 형식으로 저장" Style="{StaticResource FlyoutHeadingStyle}" />
                        <WrapPanel>
                            <ComboBox x:Name="ConvertFormatComboBox" Style="{StaticResource ToolbarComboBoxStyle}"
                                      ItemsSource="{Binding AvailableConversionFormats}" SelectedItem="{Binding SelectedConversionFormatOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanExecuteConversion}"
                                      MinWidth="114" Margin="0,0,8,0" AutomationProperties.Name="저장할 이미지 형식" />
                            <Button x:Name="ConvertImageButton" Style="{StaticResource ViewerToolbarButtonStyle}"
                                    Command="{Binding ConvertImageCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                                    Click="OnCloseImageOptionsClick" AutomationProperties.Name="변환 저장" ToolTip="변환 저장 (Ctrl+Shift+S)">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Kind="Save" Margin="0,0,7,0" />
                                    <TextBlock Text="변환 저장…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <!-- 이미지 변환 결과·오류·사전 안내 배너 -->
        <Border x:Name="ConversionNoticeBanner"
                Grid.Row="2"
                Style="{StaticResource ConversionNoticeBannerStyle}"
                Visibility="{Binding ConversionNoticeVisibility}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ConversionNoticeBadgeBorderStyle}"
                        CornerRadius="4"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="ConversionNoticeBadgeText"
                               Style="{StaticResource ConversionNoticeBadgeTextStyle}"
                               Text="{Binding ConversionNoticeBadgeText}"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                </Border>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConversionNoticeTitleText"
                               Text="{Binding ConversionNoticeTitle}"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ConversionNoticeMessageText"
                               Text="{Binding ConversionNoticeMessage}"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="OpenConvertedFileButton"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            Content="결과 파일 열기"
                            Visibility="{Binding OpenConvertedFileVisibility}"
                            Command="{Binding OpenConvertedFileCommand}"
                            Margin="0,0,6,0"
                            ToolTip="방금 변환된 결과 이미지 파일을 미리보기로 엽니다" />
                    <Button x:Name="DismissConversionNoticeButton"
                            Style="{StaticResource IconToolbarButtonStyle}"
                            AutomationProperties.Name="변환 안내 닫기"
                            Command="{Binding DismissConversionNoticeCommand}"
                            ToolTip="변환 안내 닫기">
                        <controls:AppIcon Kind="Close" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 미리보기 영역 -->
        <Grid x:Name="ContentHostGrid"
              Grid.Row="3"
              Background="{DynamicResource AppPreviewBrush}"
              SizeChanged="OnContentHostSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ArchiveColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="ArchivePanel" Grid.Column="0" Visibility="{Binding ArchiveVisibility}"
                       Background="{DynamicResource AppSurfaceBrush}" Margin="0,0,1,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ArchiveSummary}" Margin="12" FontWeight="SemiBold" />
                <ListBox x:Name="ArchiveEntryList" ItemsSource="{Binding ArchiveEntries}"
                         SelectedItem="{Binding SelectedArchiveEntry, Mode=TwoWay}" Background="{DynamicResource AppSurfaceBrush}"
                         ItemContainerStyle="{StaticResource PreviewEntryStyle}"
                         Foreground="{DynamicResource AppTextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <controls:AppIcon x:Name="EntryIcon" DockPanel.Dock="Left" Kind="File" Width="15" Height="15"
                                                  Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Top" Margin="0,2,7,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AppMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter TargetName="EntryIcon" Property="Kind" Value="Open" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel x:Name="PurPanel" Grid.Column="0" Visibility="{Binding PurVisibility}"
                       Background="{DynamicResource AppSurfaceBrush}" Margin="0,0,1,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PurSummary}" Margin="12" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ContentDescription}" Margin="12,0,12,12"
                           Foreground="{DynamicResource AppAccentTextBrush}" TextWrapping="Wrap" FontSize="12" />
                <ListBox x:Name="PurImageList" ItemsSource="{Binding PurImages}"
                         SelectedItem="{Binding SelectedPurImage, Mode=TwoWay}" Background="{DynamicResource AppSurfaceBrush}"
                         ItemContainerStyle="{StaticResource PreviewEntryStyle}"
                         Foreground="{DynamicResource AppTextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <controls:AppIcon DockPanel.Dock="Left" Kind="Image" Width="15" Height="15"
                                                  Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Top" Margin="0,2,7,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AppMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border x:Name="ArchivePlaceholder" Grid.Column="1" Visibility="{Binding ArchivePlaceholderVisibility}" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <DockPanel x:Name="TextViewport" Grid.Column="1" Visibility="{Binding TextVisibility}" Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ContentDescription}" Foreground="{DynamicResource AppAccentTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <WrapPanel x:Name="MarkdownToolbar" DockPanel.Dock="Top" Visibility="{Binding MarkdownToolbarVisibility}" Margin="0,0,0,10">
                    <CheckBox x:Name="MarkdownSourceToggle" Content="원문 보기" IsChecked="{Binding ShowMarkdownSource}"
                              VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" />
                </WrapPanel>
                <ComboBox x:Name="DocumentSectionPicker" DockPanel.Dock="Top" Margin="0,0,0,12"
                          Visibility="{Binding DocumentSectionVisibility}"
                          ItemsSource="{Binding DocumentSections}" SelectedItem="{Binding SelectedDocumentSection, Mode=TwoWay}"
                          DisplayMemberPath="Title" Style="{StaticResource ToolbarComboBoxStyle}" />
                <Grid>
                <TextBox x:Name="PreviewText" Text="{Binding TextContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         Visibility="{Binding TextSourceVisibility}"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Style="{StaticResource PreviewSourceStyle}" Padding="16"
                         FontFamily="Consolas, Malgun Gothic" FontSize="14" />
                <controls:MarkdownPreviewControl x:Name="MarkdownPreview" Markdown="{Binding MarkdownContent}" Theme="{Binding SelectedMarkdownTheme}"
                                                 Visibility="{Binding MarkdownRenderedVisibility}" />
                </Grid>
            </DockPanel>
            <Grid x:Name="RiveViewport" Grid.Column="1" Visibility="{Binding RiveVisibility}" />
            <Grid x:Name="SpecializedViewport" Grid.Column="1" Visibility="{Binding SpecializedVisibility}" />
            <!-- 1) 초기 대기 안내 -->
            <Border x:Name="EmptyStatePanel"
                    Grid.Column="1"
                    Visibility="{Binding EmptyStateVisibility}"
                    Width="440"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="26,24"
                    Margin="24">
                <StackPanel>
                    <Image Source="Assets/Brand/MoaView.png" Width="56" Height="56" Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="{Binding StatusTitle}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               TextAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="{DynamicResource AppMutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18" />
                    <Button x:Name="EmptyOpenFileButton" Style="{StaticResource PrimaryToolbarButtonStyle}"
                            Command="{Binding OpenFileCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                            HorizontalAlignment="Center" AutomationProperties.Name="파일 열기" ToolTip="파일 열기 (Ctrl+O)"
                            FontSize="14" FontWeight="SemiBold" Padding="22,8">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="Open" Margin="0,0,8,0" />
                            <TextBlock Text="파일 열기" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Ctrl+O로도 열 수 있어요" Foreground="{DynamicResource AppMutedBrush}" FontSize="12"
                               TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 2) 지원 이미지 미리보기 -->
            <Border x:Name="ImageViewport"
                    Grid.Column="1"
                    Visibility="{Binding ImageVisibility}"
                    Padding="16">
                <ScrollViewer x:Name="ImageScrollViewer"
                              BorderThickness="0"
                              Padding="0"
                              Focusable="False"
                              HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
                              SizeChanged="OnImageScrollViewerSizeChanged"
                              PreviewMouseWheel="OnImageViewportPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnImageViewportMouseLeftButtonDown"
                              PreviewMouseMove="OnImageViewportMouseMove"
                              PreviewMouseLeftButtonUp="OnImageViewportMouseLeftButtonUp"
                              LostMouseCapture="OnImageViewportLostMouseCapture">
                    <Image x:Name="PreviewImage"
                           Source="{Binding PreviewBitmap}"
                           Width="{Binding ImageDisplayWidth}"
                           Height="{Binding ImageDisplayHeight}"
                           Stretch="{Binding ImageStretch}"
                           StretchDirection="Both"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>
            </Border>

            <!-- 3) 미지원 형식 및 처리 불가 안내 -->
            <Border x:Name="NoticePanel"
                    Grid.Column="1"
                    Visibility="{Binding NoticeVisibility}"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppErrorSurfaceBrush}"
                    BorderBrush="{DynamicResource AppErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    Margin="24">
                <StackPanel>
                    <Border Background="{DynamicResource AppErrorBadgeBrush}"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="Warning" Width="15" Height="15"
                                              Foreground="{DynamicResource AppErrorTextBrush}" Margin="0,0,6,0" />
                            <TextBlock x:Name="NoticeBadgeText" Text="{Binding NoticeBadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AppErrorTextBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoticeTitleText"
                               Text="{Binding StatusTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="NoticeMessageText"
                               Text="{Binding StatusMessage}"
                               FontSize="13.5"
                               Foreground="{DynamicResource AppTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="4"
                Visibility="{Binding OpenedFileVisibility}"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentFilePathText"
                           Grid.Column="0"
                           Text="{Binding CurrentFileNameDisplay}" ToolTip="{Binding CurrentFilePathDisplay}"
                           Foreground="{DynamicResource AppMutedBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <TextBlock x:Name="ImageMetadataText"
                           Grid.Column="1"
                           Text="{Binding MetadataSummary}"
                           Foreground="{DynamicResource AppMutedBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataSummary}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
